{
  "mcpServers": {
    "gopls-mcp-server": {
      "command": "/YOUR_GO_BIN/gopls",
      "args": ["mcp"],
      "env": {}
    },
    "postgres": {
      "command": "/path/to/your/project/.kilo/scripts/run-postgres-mcp.sh",
      "args": [],
      "env": {}
    },
    "typesense": {
      "command": "/path/to/your/project/.kilo/scripts/run-typesense-mcp.sh",
      "args": [],
      "env": {}
    },
    "playwright": {
      "command": "/path/to/your/project/.kilo/scripts/run-playwright-mcp.sh",
      "args": [],
      "env": {}
    },
    "kubectl": {
      "command": "npx",
      "args": ["-y", "mcp-server-kubernetes"],
      "env": {
        "KUBECONFIG": "/path/to/your/kubeconfig.yaml"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/your/project"],
      "env": {}
    },
    "google-kubernetes-engine": {
      "serverUrl": "https://container.googleapis.com/mcp",
      "authProviderType": "google_credentials"
    },
    "ZohoMCP": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://YOUR_WORKSPACE.zohomcp.com/mcp/YOUR_MCP_TOKEN/message",
        "--transport",
        "http-only"
      ]
    },
    "runpod": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "https://mcp.getrunpod.io/"]
    }
  }
}
